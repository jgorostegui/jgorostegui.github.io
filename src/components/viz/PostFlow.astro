---
/**
 * A pipeline drawn as a figure, from a mermaid flowchart that is a single chain (A --> B --> C ...), without running
 * mermaid. The same source renders as an ordinary mermaid diagram anywhere else. Each node may name its role with a
 * mermaid class: :::inputs (first node; its label lists the inputs, "a · b · c", which fan in), :::gate (a check
 * drawn across the flow) or :::store (last node; a cylinder with what it keeps, "a · b"). Nodes without a role are
 * boxes; <br/> splits a box label into a title and a detail line. Anything the figure could not draw faithfully
 * fails the build. Horizontal; vertical when the figure is narrow.
 */
import './viz.css'

interface Props {
  source: string
  label: string
  caption?: string
}

const { source, label, caption } = Astro.props
const fail = (msg: string): never => {
  throw new Error(`PostFlow (${label}): ${msg}`)
}

type Role = 'inputs' | 'gate' | 'store' | 'step'
const ROLES: Role[] = ['inputs', 'gate', 'store', 'step']
const nodes = new Map<string, { text: string; role: Role }>()
const edges: [string, string][] = []
source.split('\n').forEach((raw, i) => {
  const line = raw.trim()
  if (!line || line.startsWith('%%') || line.startsWith('classDef ')) return
  if (/^(flowchart|graph)\s+(TB|TD|BT|LR|RL)$/.test(line)) return
  const n = line.match(/^([A-Za-z0-9_]+)\s*\[\s*"(.*?)"\s*\](?::::([A-Za-z]+))?$/)
  if (n) {
    if (nodes.has(n[1])) fail(`node ${n[1]} is declared twice (line ${i + 1})`)
    const role = (n[3] ?? 'step') as Role
    if (!ROLES.includes(role)) fail(`unknown role :::${n[3]} (line ${i + 1})`)
    nodes.set(n[1], { text: n[2], role })
    return
  }
  const e = line.match(/^([A-Za-z0-9_]+)\s*-->\s*([A-Za-z0-9_]+)$/)
  if (e) return void edges.push([e[1], e[2]])
  fail(`line ${i + 1} is not a node, an edge or a classDef: "${line}"`)
})

// One chain: edges only between declared nodes, at most one way in and one way out of each, a single start, every
// node reached from it
const next = new Map<string, string>()
const into = new Set<string>()
for (const [a, b] of edges) {
  if (!nodes.has(a) || !nodes.has(b)) fail(`edge ${a} --> ${b} uses an undeclared node`)
  if (next.has(a)) fail(`${a} has two outgoing edges`)
  if (into.has(b)) fail(`${b} has two incoming edges`)
  next.set(a, b)
  into.add(b)
}
const starts = [...nodes.keys()].filter((k) => !into.has(k))
if (starts.length !== 1) fail(`a single chain has one start; this one has ${starts.length}`)
const order: string[] = []
for (let at: string | undefined = starts[0]; at; at = next.get(at)) order.push(at)
if (order.length !== nodes.size || order.length < 3) fail('the flowchart is not a single chain of three or more nodes')

type Step =
  | { kind: 'inputs'; items: string[] }
  | { kind: 'box'; lines: string[] }
  | { kind: 'gate'; text: string }
  | { kind: 'store'; items: string[] }
const steps: Step[] = order.map((id, i) => {
  const { text, role } = nodes.get(id)!
  const last = i === order.length - 1
  if (role === 'inputs' && i !== 0) fail(`${id}: :::inputs must be the first node`)
  if (role === 'store' && !last) fail(`${id}: :::store must be the last node`)
  if (role === 'gate' && (i === 0 || last)) fail(`${id}: :::gate must sit between two nodes`)
  if (role === 'inputs') return { kind: 'inputs', items: text.split(' · ') }
  if (role === 'store') return { kind: 'store', items: text.split(' · ') }
  if (role === 'gate') return { kind: 'gate', text }
  return { kind: 'box', lines: text.split(/<br\s*\/?>/) }
})

// Marker ids from the content, so two diagrams on one page do not share them
let h = 5381
for (const c of label + source) h = ((h << 5) + h + c.charCodeAt(0)) | 0
const uid = `vf-${(h >>> 0).toString(36)}`

// Text width estimates for the boxes (Geist 12.5px, JetBrains Mono 10.5px)
const sansW = (s: string) => s.length * 6.7
const monoW = (s: string) => s.length * 6.3
const boxW = (lines: string[]) => Math.ceil(Math.max(sansW(lines[0]), ...lines.slice(1).map(monoW)) + 28)
const boxH = (lines: string[]) => 22 + lines.length * 14

// ---- Horizontal ----
const H = { h: 196, cy: 104, gap: 36 }
let x = 0
const hParts: { kind: string; x: number; w: number; s: Step }[] = []
for (const s of steps) {
  let w = 0
  if (s.kind === 'inputs') w = Math.ceil(Math.max(...s.items.map(monoW))) + 18
  if (s.kind === 'box') w = boxW(s.lines)
  if (s.kind === 'gate') w = 4
  if (s.kind === 'store') w = Math.max(56, Math.ceil(Math.max(...s.items.map(monoW))))
  hParts.push({ kind: s.kind, x, w, s })
  x += w + H.gap + (s.kind === 'inputs' ? 24 : 0)
}
const HW = Math.ceil(x - H.gap + 8)
const inY = (n: number, i: number) => H.cy + (i - (n - 1) / 2) * 34

// ---- Vertical ----
const V = { w: 320, cx: 160, gap: 30 }
let y = 0
const vParts: { kind: string; y: number; h: number; s: Step }[] = []
for (const s of steps) {
  let h = 0
  if (s.kind === 'inputs') h = 34
  if (s.kind === 'box') h = boxH(s.lines)
  if (s.kind === 'gate') h = 28
  if (s.kind === 'store') h = 46 + 16
  vParts.push({ kind: s.kind, y, h, s })
  y += h + V.gap + (s.kind === 'inputs' ? 16 : 0)
}
const VH = Math.ceil(y - V.gap + 6)
const inX = (n: number, i: number) => V.cx + (i - (n - 1) / 2) * 92

const cyl = (cx: number, top: number, w: number, h: number) => {
  const rx = w / 2
  const ry = 6
  return {
    body: `M${cx - rx},${top + ry} v${h - 2 * ry} a${rx},${ry} 0 0 0 ${w},0 v${-(h - 2 * ry)}`,
    top: { cx, cy: top + ry, rx, ry },
  }
}
---

<figure class="viz viz-flow not-prose" aria-label={label}>
  {caption && <p class="viz-plate">{caption}</p>}
  <svg class="vf-h" viewBox={`0 0 ${HW} ${H.h}`} aria-hidden="true">
    <defs>
      <marker id={`${uid}-h`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path class="vf-head" d="M0,0 L8,4 L0,8 z"></path>
      </marker>
    </defs>
    {
      hParts.map((p, i) => {
        const nxt = hParts[i + 1]
        const right = p.x + p.w
        const link = nxt && p.kind !== 'inputs' && (
          <line class="vf-edge" x1={right} y1={H.cy} x2={nxt.x - (nxt.kind === 'gate' ? 2 : 3)} y2={H.cy} marker-end={nxt.kind === 'gate' ? undefined : `url(#${uid}-h)`} />
        )
        if (p.s.kind === 'inputs') {
          const items = p.s.items
          const target = nxt.x - 3
          return (
            <g>
              {items.map((it, k) => {
                const yy = inY(items.length, k)
                return (
                  <g>
                    <text class="vf-m" x={p.x + p.w - 14} y={yy + 3.5} text-anchor="end">{it.toLowerCase()}</text>
                    <circle class="vf-dot" cx={p.x + p.w - 6} cy={yy} r="3.5" />
                    <path class="vf-edge" d={`M${p.x + p.w - 2},${yy} C${p.x + p.w + 30},${yy} ${target - 34},${H.cy} ${target},${H.cy}`} marker-end={`url(#${uid}-h)`} />
                  </g>
                )
              })}
            </g>
          )
        }
        if (p.s.kind === 'box') {
          const lines = p.s.lines
          const h = boxH(lines)
          return (
            <g>
              <rect class="vf-box" x={p.x} y={H.cy - h / 2} width={p.w} height={h} rx="5" />
              {lines.map((l, k) => (
                <text class={k ? 'vf-s' : 'vf-t'} x={p.x + p.w / 2} y={H.cy - ((lines.length - 1) * 14) / 2 + k * 14 + 4} text-anchor="middle">{l}</text>
              ))}
              {link}
            </g>
          )
        }
        if (p.s.kind === 'gate') {
          return (
            <g>
              <text class="vf-g" x={p.x + 2} y={H.cy - 66} text-anchor="middle">{p.s.text.toLowerCase()}</text>
              <rect class="vf-gate" x={p.x} y={H.cy - 56} width={p.w} height="112" rx="2" />
              {link}
            </g>
          )
        }
        const c = cyl(p.x + p.w / 2, H.cy - 22, Math.min(p.w, 56), 44)
        return (
          <g>
            <path class="vf-box" d={c.body} />
            <ellipse class="vf-box" cx={c.top.cx} cy={c.top.cy} rx={c.top.rx} ry={c.top.ry} />
            {p.s.items.map((it, k) => (
              <text class="vf-m" x={p.x + p.w / 2} y={H.cy + 40 + k * 14} text-anchor="middle">{it}</text>
            ))}
          </g>
        )
      })
    }
  </svg>

  <svg class="vf-v" viewBox={`0 0 ${V.w} ${VH}`} aria-hidden="true">
    <defs>
      <marker id={`${uid}-v`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path class="vf-head" d="M0,0 L8,4 L0,8 z"></path>
      </marker>
    </defs>
    {
      vParts.map((p, i) => {
        const nxt = vParts[i + 1]
        const bottom = p.y + p.h
        const link = nxt && p.kind !== 'inputs' && (
          <line class="vf-edge" x1={V.cx} y1={bottom} x2={V.cx} y2={nxt.y - (nxt.kind === 'gate' ? 2 : 3)} marker-end={nxt.kind === 'gate' ? undefined : `url(#${uid}-v)`} />
        )
        if (p.s.kind === 'inputs') {
          const items = p.s.items
          return (
            <g>
              {items.map((it, k) => {
                const xx = inX(items.length, k)
                return (
                  <g>
                    <text class="vf-m" x={xx} y={p.y + 10} text-anchor="middle">{it.toLowerCase()}</text>
                    <circle class="vf-dot" cx={xx} cy={p.y + 22} r="3.5" />
                    <path class="vf-edge" d={`M${xx},${p.y + 26} C${xx},${p.y + 48} ${V.cx},${nxt.y - 26} ${V.cx},${nxt.y - 3}`} marker-end={`url(#${uid}-v)`} />
                  </g>
                )
              })}
            </g>
          )
        }
        if (p.s.kind === 'box') {
          const lines = p.s.lines
          const w = boxW(lines)
          return (
            <g>
              <rect class="vf-box" x={V.cx - w / 2} y={p.y} width={w} height={p.h} rx="5" />
              {lines.map((l, k) => (
                <text class={k ? 'vf-s' : 'vf-t'} x={V.cx} y={p.y + 15 + k * 14 + 4} text-anchor="middle">{l}</text>
              ))}
              {link}
            </g>
          )
        }
        if (p.s.kind === 'gate') {
          return (
            <g>
              <rect class="vf-gate" x={V.cx - 110} y={p.y + 4} width="220" height="4" rx="2" />
              <text class="vf-g" x={V.cx} y={p.y + 24} text-anchor="middle">{p.s.text.toLowerCase()}</text>
              {link}
            </g>
          )
        }
        const c = cyl(V.cx, p.y, 56, 44)
        return (
          <g>
            <path class="vf-box" d={c.body} />
            <ellipse class="vf-box" cx={c.top.cx} cy={c.top.cy} rx={c.top.rx} ry={c.top.ry} />
            <text class="vf-m" x={V.cx} y={p.y + 60} text-anchor="middle">{p.s.items.join(' · ')}</text>
          </g>
        )
      })
    }
  </svg>
</figure>

<style is:global>
  .viz-flow {
    container-type: inline-size;
  }

  .viz-flow svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .vf-v {
    display: none !important;
    max-width: 22rem;
    margin-inline: auto;
  }

  @container (max-width: 30rem) {
    .vf-h {
      display: none !important;
    }

    .vf-v {
      display: block !important;
    }
  }

  .vf-box {
    fill: var(--background);
    stroke: color-mix(in oklab, var(--foreground) 30%, var(--background));
    stroke-width: 1;
  }

  .vf-edge {
    fill: none;
    stroke: var(--muted-foreground);
    stroke-width: 1.25;
  }

  .vf-head {
    fill: var(--muted-foreground);
  }

  .vf-dot {
    fill: var(--muted-foreground);
  }

  .vf-gate {
    fill: var(--viz-1);
  }

  [data-theme='cyberpunk'] .vf-gate {
    filter: drop-shadow(0 0 4px var(--viz-1));
  }

  .viz-flow text {
    font-variant-numeric: tabular-nums;
  }

  .vf-t {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 12.5px;
  }

  .vf-s,
  .vf-m {
    fill: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 10.5px;
  }

  .vf-g {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 10.5px;
  }
</style>
