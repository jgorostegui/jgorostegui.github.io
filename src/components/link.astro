---
import { cn } from '@/lib/utils'

interface Props {
  href: string
  external?: boolean
  class?: string
  underline?: boolean
  rel?: string
  target?: string
  [key: string]: any
}

const {
  href,
  external,
  class: className,
  underline,
  rel,
  target,
  ...rest
} = Astro.props

const targetValue = external ? '_blank' : (target ?? '_self')
const relValue =
  targetValue === '_blank'
    ? Array.from(
        new Set([
          'noopener',
          'noreferrer',
          ...String(rel || '')
            .split(/\s+/)
            .filter(Boolean),
        ]),
      ).join(' ')
    : rel
---

<a
  href={href}
  target={targetValue}
  rel={relValue}
  class={cn(
    'inline-block transition-colors duration-300 ease-in-out',
    underline &&
      'underline decoration-muted-foreground underline-offset-[3px] hover:decoration-foreground',
    className,
  )}
  {...rest}
>
  <slot />
</a>
