---
import SetupHero from '@/components/hero/setup-hero.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { buttonVariants } from '@/components/ui/button'
import HomeFigure from '@/components/viz/HomeFigure.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/layout.astro'
import { getCombinedReadingTime, getRecentPosts } from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'

const blog = await getRecentPosts(SITE.featuredPostCount)
// A post with homeFigure in its frontmatter shows that figure beside its title; any other post is a text entry
// (title and description, full width)
const entries = await Promise.all(
  blog.map(async (post) => ({
    post,
    hasFig: !!post.data.homeFigure,
    readTime: await getCombinedReadingTime(post.id),
  })),
)
---

<Layout class="max-w-(--wide-column)" wide>
  <PageHead slot="head" title="Home" />
  <SetupHero slot="hero" />

  <section class="home-latest" aria-labelledby="latest-posts">
    <h2 id="latest-posts" class="font-mono text-lg font-medium tracking-tight">
      Latest posts
    </h2>
    <ol class="home-list">
      {
        entries.map(({ post, hasFig, readTime }) => (
          <li class:list={['home-entry', { 'home-entry--text': !hasFig }]}>
            <div class="home-text">
              <p class="text-muted-foreground flex flex-wrap gap-x-3 font-mono text-xs">
                <time datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                <span>{readTime}</span>
              </p>
              <h3 class="home-h">
                <Link href={`/${post.collection}/${post.id}`} class="home-title">
                  {post.data.title}
                </Link>
              </h3>
              <p class="text-muted-foreground home-desc">{post.data.description}</p>
            </div>
            {hasFig && (
              <div class="home-fig">
                <HomeFigure post={post} />
              </div>
            )}
          </li>
        ))
      }
    </ol>
    <div>
      <Link
        href="/blog"
        class={buttonVariants({ variant: 'ghost' }) + ' group -ml-4'}
      >
        See all posts <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>
  </section>
</Layout>

<style>
  .home-latest {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .home-list {
    display: flex;
    flex-direction: column;
  }

  .home-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    column-gap: 3.5rem;
    align-items: start;
    padding-block: 2rem 2.25rem;
    border-top: 1px solid var(--border);
  }

  .home-text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  /* The post's title and description, as on the post itself: large title, italic description */
  .home-h {
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.75rem);
    font-weight: 500;
    line-height: 1.2;
    text-wrap: balance;
  }

  .home-title:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .home-fig {
    min-width: 0;
  }

  .home-fig :global(.viz) {
    margin: 0;
  }

  /* A post without a figure: one column, the description in place of the figure */
  .home-entry--text {
    grid-template-columns: minmax(0, 1fr);
  }

  .home-desc {
    max-width: 36rem;
    font-size: 1rem;
    font-style: italic;
    line-height: 1.55;
    text-wrap: pretty;
  }

  @media (max-width: 56rem) {
    .home-entry {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.25rem;
    }
  }
</style>
